# =====================================================================
# DISASTER RELIEF RESOURCE MANAGEMENT SYSTEM (DRRMS)
# ENVIRONMENT CONFIGURATION TEMPLATE
# PES University - DBMS Experiential Learning Project
# =====================================================================

# Server Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Disaster Relief Resource Management System"

# ---------------------------------------------------------------------
# PRIMARY SQL DATABASE (MySQL or PostgreSQL)
# ---------------------------------------------------------------------
DB_DIALECT=mysql                     # Options: 'mysql' | 'postgres'
DB_HOST=localhost
DB_PORT=3306                         # 3306 for MySQL, 5432 for PostgreSQL
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=disaster_relief_db
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------
# SECONDARY DATABASE - OPTION B: NoSQL (MongoDB)
# High-velocity Volunteer Action Logs & Supply Chain Telemetry
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/drrms_telemetry
MONGODB_DB_NAME=drrms_telemetry

# ---------------------------------------------------------------------
# SECONDARY DATABASE - OPTION A: Vector DB / Semantic Search
# pgvector or Gemini/OpenAI Embedding API Key for SOS incident matching
# ---------------------------------------------------------------------
VECTOR_SIMILARITY_THRESHOLD=0.75
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# AUTHENTICATION & SECURITY (RBAC)
# ---------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_pes_dbms_level3_project_2026
JWT_EXPIRES_IN=24h
